<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:padding="16dp"
  android:background="@drawable/tree_widget_background">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Stromobraní 🌳"
    android:textColor="#F7F2E4"
    android:textSize="16sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/tree_widget_streak"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="0 dní v sérii"
    android:textColor="#E9B44C"
    android:textSize="14sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/tree_widget_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Žádný strom poblíž"
    android:textColor="#FFFFFF"
    android:textSize="13sp" />
  <TextView
    android:id="@+id/tree_widget_distance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="#D5E2D0"
    android:textSize="12sp" />
</LinearLayout>
