{
  "expo": {
    "name": "Stromobraní",
    "slug": "stromobrani",
    "version": "1.8.0",
    "scheme": "stromobrani",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f7f2e4",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.stromobrani.app"
    },
    "android": {
      "package": "cz.stromobrani.app",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f3d2b"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "stromobrani-9389.rostiapp.cz",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "stromobrani"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withAppForceDark",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2764641499857589~7303600829",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Stromobraní používá pohybové senzory ke stabilizaci kompasu v Radaru."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1f3d2b",
          "imageWidth": 200
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TreeWidget",
              "displayName": "Stromobraní",
              "description": "Aktuální série a nejbližší památný strom.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stromobraní potřebuje tvou polohu, aby ověřilo, že stojíš u stromu.",
          "locationAlwaysAndWhenInUsePermission": "Stromobraní může zjišťovat polohu i na pozadí, aby ti poslalo upozornění, že jsi poblíž nenavštíveného stromu. Poloha zůstává v telefonu.",
          "locationAlwaysPermission": "Stromobraní může zjišťovat polohu i na pozadí, aby ti poslalo upozornění, že jsi poblíž nenavštíveného stromu. Poloha zůstává v telefonu.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stromobraní potřebuje přístup k fotkám, abys mohl(a) přidat fotku stromu.",
          "cameraPermission": "Stromobraní potřebuje fotoaparát, abys mohl(a) vyfotit strom.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class io.invertase.googlemobileads.** { *; }\n-keep class org.maplibre.** { *; }\n-dontwarn org.maplibre.**\n-keep class com.android.billingclient.** { *; }\n-dontwarn com.google.android.gms.**\n-keep class cz.stromobrani.** { *; }"
          }
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "playIntegrityCloudProjectNumber": 556430124144,
      "eas": {
        "projectId": "f97d40c4-a854-4219-825a-d623777c57fa"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f97d40c4-a854-4219-825a-d623777c57fa"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/expo"
    }
  }
}
